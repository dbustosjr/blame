{
  "name": "@blame-ai/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Blame design tokens from docs/DESIGN.md for the terminal, the VS Code extension and the website.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@blame-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "themes"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "themes": "pnpm build && node dist/write-themes.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
